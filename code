const int switchPin = 2;
const int porchLightPin = 5;
const int hallLightPin = 6;

const unsigned long porchDuration = 30000;
const unsigned long hallDuration = 60000;

bool systemActive = false;
bool lastSwitchState = HIGH;
unsigned long startTime = 0;

void setupPins() {
  pinMode(switchPin, INPUT_PULLUP);
  pinMode(porchLightPin, OUTPUT);
  pinMode(hallLightPin, OUTPUT);

  digitalWrite(porchLightPin, LOW);
  digitalWrite(hallLightPin, LOW);
}

bool isSwitchActivated() {
  return digitalRead(switchPin) == LOW;
}

void startLightingSystem() {
  systemActive = true;
  startTime = millis();
  digitalWrite(porchLightPin, HIGH);
  digitalWrite(hallLightPin, HIGH);
}

void updatePorchLight(unsigned long elapsedTime) {
  if (elapsedTime >= porchDuration) {
    digitalWrite(porchLightPin, LOW);
  }
}

void updateHallLight(unsigned long elapsedTime) {
  if (elapsedTime >= hallDuration) {
    digitalWrite(hallLightPin, LOW);
    systemActive = false;
  }
}

void updateLights() {
  if (systemActive) {
    unsigned long elapsedTime = millis() - startTime;
    updatePorchLight(elapsedTime);
    updateHallLight(elapsedTime);
  }
}

void checkSwitch() {
  bool currentSwitchState = digitalRead(switchPin);

  if (lastSwitchState == HIGH && currentSwitchState == LOW && !systemActive) {
    startLightingSystem();
  }

  lastSwitchState = currentSwitchState;
}

void setup() {
  setupPins();
}

void loop() {
  checkSwitch();
  updateLights();
}
